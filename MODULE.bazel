"""Bazel by Example: C/C++

A collection of self-contained and runnable examples demonstrating Bazel concepts
specifically for C and C++ developers. Covers everything from basic executables
and libraries to testing, external dependencies, and advanced build configuration.
"""

# Bazel Module Documentation: https://bazel.build/external/module
# API documentation: https://bazel.build/rules/lib/globals/module
module(
    name = "bazel-by-example",

    # Bazel adopts a relaxed form of SemVer for versioning that still allows
    # for Minimal Version Selection (MVS). This allows multiple dependencies
    # of a Bazel module to declare a dendency on different, but compatible,
    # versions of a module and Bazel to resolve the difference.
    # 
    # https://bazel.build/external/module#version-format
    # https://bazel.build/external/module#version-selection
    version = "1.0.0",

    # The compatibility_level attribute is a version number that indicates backwards 
    # compatibility for a Bazel module, similar to SemVer's major version number.
    #
    # https://bazel.build/external/module#compatibility_level
    compatibility_level = 1
)

# rules_cc is Bazel's official ruleset for C and C++ programming languages.
# It provides essential build rules like:
#   - cc_binary: Builds executable programs from your C/C++ source code
#   - cc_library: Creates reusable code libraries, both static and shared
#   - cc_test: Compiles and runs tests for your C/C++ code
#
# https://github.com/bazelbuild/rules_cc
bazel_dep(name = "rules_cc", version = "0.2.0")

# toolchains_cc is a Bazel module providing C/C++ toolchain configurations.
#
# toolchains_cc simplifies the process of setting up C/C++ toolchains by:
# - being easy to configuration with minimal setup required,
# - focusing on hermetic builds that are reproducible and isolated from the host system, and
# - providing cross-platform support for Linux, macOS, and Windows environments.
#
# This module helps reduce "works on my machine" issues by providing consistent builds
# across different development and CI environments.
bazel_dep(name = "toolchains_cc", dev_dependency = True)
git_override(
    module_name = "toolchains_cc",
    remote = "https://github.com/reutermj/toolchains_cc",
    commit = "6642c76585f357bc6217eb4074eeb66ecc74f55a",
)
register_toolchains("@toolchains_cc", dev_dependency = True)
